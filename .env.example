# Copy to .env, or let `./install.sh` write it for you.
# Every key here is read by slcw/config.py — there are no decorative settings.

# ── Credentials (required) ──────────────────────────────────────────────
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id from @userinfobot. Only this chat may command the bot.
TELEGRAM_CHAT_ID=
# The game's public Firebase web API key, visible in the frontend bundle.
SLCW_FIREBASE_API_KEY=

# ── Vault ───────────────────────────────────────────────────────────────
# Leave unset to unlock from Telegram after every restart. `install.sh` can
# instead write this to a separate root-only .vault-key file for unattended
# reboots — see docs/ARCHITECTURE.md for the trade-off.
#SLCW_VAULT_PASSPHRASE=

# ── Master switches ─────────────────────────────────────────────────────
# false = claims and rest only, no gameplay actions.
SLCW_ENABLED=true
# true = decide and log, never call the game. Use this on a first run.
SLCW_DRY_RUN=true

# ── Pacing (seconds) ────────────────────────────────────────────────────
# Delay between a server activity ending and the bot reacting, log-normal
# shaped around the median. Widening these makes the bot slower and quieter.
SLCW_REACTION_MEDIAN_SECONDS=90
SLCW_REACTION_MIN_SECONDS=15
SLCW_REACTION_MAX_SECONDS=480
# Poll spacing when a wallet has nothing pending.
SLCW_IDLE_MIN_SECONDS=240
SLCW_IDLE_MAX_SECONDS=900
# Daily offline window assigned per wallet, so accounts do not move in lockstep.
SLCW_SLEEP_MIN_HOURS=6
SLCW_SLEEP_MAX_HOURS=9

# ── Resilience ──────────────────────────────────────────────────────────
# Consecutive non-transient errors before a wallet pauses itself.
SLCW_MAX_ERRORS=3
SLCW_HTTP_MAX_ATTEMPTS=4
SLCW_HTTP_BACKOFF_BASE=1.6
SLCW_HTTP_TIMEOUT=30

# ── Gameplay policy ─────────────────────────────────────────────────────
# Rest when health or mana falls below these fractions.
SLCW_REST_HP_RATIO=0.55
SLCW_REST_MP_RATIO=0.25
SLCW_BATTLE_MAX_TURNS=12
SLCW_MARKET_TTL_SECONDS=1800
# Gold-mode gathering runs this many hours (1-8) and costs no energy.
SLCW_FARMING_GOLD_HOURS=8
# Gold-funded actions may never spend below this reserve.
SLCW_GOLD_RESERVE=500
# Item drops worth at least this much at best bid raise a Telegram alert.
SLCW_RICH_DROP_GOLD=2000
# Optional starting location preference.
#SLCW_HOME_LOCATION=
