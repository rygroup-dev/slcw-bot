# Copy to .env, or let `./install.sh` write it for you.
# Every key here is read by slcw/config.py — there are no decorative settings.

# ── Credentials (required) ──────────────────────────────────────────────
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id from @userinfobot. Only this chat may command the bot.
TELEGRAM_CHAT_ID=
# The game's public Firebase web API key, visible in the frontend bundle.
SLCW_FIREBASE_API_KEY=

# ── Vault ───────────────────────────────────────────────────────────────
# Leave unset to unlock from Telegram after every restart. `install.sh` can
# instead write this to a separate root-only .vault-key file for unattended
# reboots — see docs/ARCHITECTURE.md for the trade-off.
#SLCW_VAULT_PASSPHRASE=

# ── Master switches ─────────────────────────────────────────────────────
# false = claims and rest only, no gameplay actions.
SLCW_ENABLED=true
# true = decide and log, never call the game. Use this on a first run.
SLCW_DRY_RUN=true

# ── Pacing (seconds) ────────────────────────────────────────────────────
# Delay between a server activity ending and the bot reacting, log-normal
# shaped around the median. Widening these makes the bot slower and quieter.
SLCW_REACTION_MEDIAN_SECONDS=90
SLCW_REACTION_MIN_SECONDS=15
SLCW_REACTION_MAX_SECONDS=480
# Poll spacing when a wallet has nothing pending.
SLCW_IDLE_MIN_SECONDS=240
SLCW_IDLE_MAX_SECONDS=900

# ── Resilience ──────────────────────────────────────────────────────────
# Consecutive non-transient errors before a wallet pauses itself.
SLCW_MAX_ERRORS=3
SLCW_HTTP_MAX_ATTEMPTS=4
SLCW_HTTP_BACKOFF_BASE=1.6
SLCW_HTTP_TIMEOUT=30

# ── Gameplay policy ─────────────────────────────────────────────────────
# Rest when health or mana falls below these fractions.
SLCW_REST_HP_RATIO=0.55
SLCW_REST_MP_RATIO=0.25
SLCW_BATTLE_MAX_TURNS=12
SLCW_MARKET_TTL_SECONDS=1800
# Gold-mode gathering locks a wallet for hours with no levelling. It also
# SPENDS gold to produce resources rather than earning any, so it is a sink,
# not an income source. The Telegram economy menu toggles this and writes the
# new value back here, so a change there survives a restart.
SLCW_FARMING_GOLD=true
# Gold-mode gathering runs this many hours (1-8) and costs no energy.
SLCW_FARMING_GOLD_HOURS=8
# Let the engine relocate wallets between gathering sites and battle/workshop
# cities on its own. Keep this true — turning it off stops wallets from
# reaching farm_3 to fight, level, or reach hunt tasks at all.
SLCW_AUTO_TRAVEL=true
# Gold-funded actions may never spend below this reserve.
SLCW_GOLD_RESERVE=500
# Item drops worth at least this much at best bid raise a Telegram alert.
SLCW_RICH_DROP_GOLD=2000
# Optional starting location preference.
#SLCW_HOME_LOCATION=

# ── Clans ───────────────────────────────────────────────────────────────
# Clan participation as a whole. Leave true: the useful half costs nothing.
SLCW_CLAN_ENABLED=true

# Submitting clan quest resources spends raw drops, which have no bids on the
# market at all, in exchange for DKP and clan XP. That runs automatically and
# needs no key here.
#
# Donating GOLD is different and is off by default. It converts at 1,000 gold
# = 1 DKP, once per wallet per UTC day, into a treasury the clan LEADER decides
# how to distribute. In someone else's clan that is gold given away against a
# claim they honour. Turn it on only for a clan you control.
SLCW_CLAN_DONATE_GOLD=false
# Gold held back from any donation, on top of SLCW_GOLD_RESERVE.
SLCW_CLAN_GOLD_RESERVE=5000

# Founding your own clan. There is NO player-to-player gold transfer in this
# game, so a clan is paid for by one wallet saving up the 20,000 gold it costs.
# Name the wallet here and it spends no gold at all until it can afford that.
#SLCW_CLAN_FOUNDER_WALLET=wallet-01
# With this true, that wallet founds the clan by itself the moment it can, and
# exactly once — the id is written to data/clan.json and the branch refuses to
# run again while any id is recorded there.
SLCW_CLAN_AUTO_FOUND=false
# Clan identity. Tag is at most 4 characters. Choose carefully: renaming a clan
# is a denied operation, so the bot cannot correct a name it got wrong.
#SLCW_CLAN_NAME=My Clan
#SLCW_CLAN_TAG=MYC
# Every wallet outside the clan applies to it, and the leader admits requests
# from this vault's own wallets only — never a stranger's. A wallet added to
# the vault later joins by the same route with no extra step. Note a new clan
# has only 10 seats; that cap rises as the clan levels up.
SLCW_CLAN_AUTO_JOIN=true
