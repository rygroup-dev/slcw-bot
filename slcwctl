#!/root/slcw-bot/.venv/bin/python
"""Command-line administration for the SLCW bot.

Usage:
  slcwctl setup         Interactive first-run setup (credentials, vault, wallet, service)
  slcwctl init          Create the vault and migrate any plaintext wallets.json
  slcwctl list          List wallets (public keys only)
  slcwctl new [N]       Generate N new wallets
  slcwctl import        Import an existing wallet (secret read from a prompt)
  slcwctl doctor        Check configuration and environment health
  slcwctl once <id>     Run one cycle for a wallet and print the decision
  slcwctl why <id>      Show the last recorded decision rationale

Clan administration. These four call endpoints the decision loop never touches:
founding a clan spends 20,000 gold in one go, and admitting a member or starting
the weekly quest are decisions about a clan you own, not moves in a game loop.

  slcwctl clan-status              Show every wallet's clan standing
  slcwctl clan-create <id> <name> <TAG>
                                   Found a clan from one wallet (20,000 gold)
  slcwctl clan-apply <clanId> [id...]
                                   Apply wallets to a clan (all others by default)
  slcwctl clan-accept <clanId>     Accept every pending application (leader only)
  slcwctl clan-quest <id> <clanId> Start the clan's free weekly quest
"""
from __future__ import annotations

import getpass
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

def _load_env_file(path: Path) -> None:
    """Load simple KEY=VALUE pairs like systemd EnvironmentFile."""
    if not path.exists():
        return

    for raw in path.read_text().splitlines():
        line = raw.strip()

        if not line or line.startswith("#") or "=" not in line:
            continue

        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()

        if not key:
            continue

        # Do not override an explicitly exported shell environment variable.
        if key not in os.environ:
            if (
                len(value) >= 2
                and value[0] == value[-1]
                and value[0] in ("'", '"')
            ):
                value = value[1:-1]

            os.environ[key] = value

_load_env_file(ROOT / ".env")

sys.path.insert(0, str(ROOT))

from slcw import config as config_mod  # noqa: E402
from slcw.api import GameApi  # noqa: E402
from slcw.auth import SessionManager  # noqa: E402
from slcw.orchestrator import Orchestrator  # noqa: E402
from slcw.transport import Transport  # noqa: E402
from slcw.vault import Vault, VaultError  # noqa: E402


def unlock(vault: Vault) -> str:
    passphrase = getpass.getpass("Vault passphrase: ")
    try:
        count = vault.unlock(passphrase)
    except VaultError as exc:
        sys.exit(f"error: {exc}")
    print(f"vault unlocked: {count} wallet(s)")
    return passphrase


def cmd_init() -> int:
    vault = Vault()
    if vault.exists:
        print("vault already exists")
        passphrase = unlock(vault)
    else:
        passphrase = getpass.getpass("New vault passphrase: ")
        confirm = getpass.getpass("Confirm: ")
        if passphrase != confirm:
            sys.exit("error: passphrases do not match")
        if len(passphrase) < 10:
            sys.exit("error: use at least 10 characters")
        vault.unlock(passphrase)

    migrated = vault.import_legacy(passphrase)
    if migrated:
        print(f"migrated {migrated} wallet(s) from plaintext wallets.json")
        print("plaintext file renamed to wallets.json.migrated — delete it once verified")
    else:
        vault.create_wallets(0)
        print("vault ready")
    return 0


def cmd_list() -> int:
    vault = Vault()
    unlock(vault)
    for wallet in vault.public_summary():
        print(f"{wallet['id']:12s} {wallet['nickname']:16s} {wallet['public_key']} "
              f"proxy={wallet['proxy']} {'enabled' if wallet['enabled'] else 'paused'}")
    return 0


def cmd_new(count: int) -> int:
    vault = Vault()
    unlock(vault)
    created = vault.create_wallets(count)
    for wallet in created:
        print(f"{wallet['id']} {wallet['nickname']} {wallet['public_key']}")
    print(f"\n{len(created)} wallet(s) created and encrypted. Private keys stay in the vault.")
    return 0


def cmd_import() -> int:
    """Import from a hidden prompt, so the secret never enters shell history."""
    from slcw import keys

    vault = Vault()
    unlock(vault)
    secret = getpass.getpass("Secret (base58 / JSON array / hex / seed phrase): ")
    passphrase = ""
    if len(secret.split()) >= 12:
        passphrase = getpass.getpass("BIP39 passphrase (blank if none): ")

    try:
        candidates = keys.parse_secret(secret, passphrase)
    except keys.KeyImportError as exc:
        sys.exit(f"error: {exc}")

    if len(candidates) == 1:
        chosen = candidates[0]
    else:
        print("\nThis phrase maps to more than one account. Pick the one you own:")
        for index, candidate in enumerate(candidates):
            print(f"  [{index}] {candidate.source}\n      {candidate.public_key}")
        try:
            chosen = candidates[int(input("Choice: ").strip())]
        except (ValueError, IndexError):
            sys.exit("error: invalid choice")

    try:
        wallet = vault.import_wallet(chosen.private_key, chosen.public_key)
    except ValueError as exc:
        sys.exit(f"error: {exc}")

    print(f"\nimported {wallet['id']} {wallet['nickname']} {wallet['public_key']}")
    print("restart slcw-fleet, or use the Telegram menu, to start its worker")
    return 0


def cmd_doctor() -> int:
    config = config_mod.load()
    problems = config.validate()
    print(f"python           {sys.executable}")
    print(f"enabled          {config.enabled}")
    print(f"dry_run          {config.dry_run}")
    print(f"vault present    {Vault().exists}")
    print(f"max errors       {config.max_consecutive_errors}")
    print(f"http attempts    {config.http_max_attempts}")
    print(f"reaction median  {config.reaction_median_seconds}s")
    try:
        import curl_cffi  # noqa: F401
        print("curl_cffi        installed")
    except ImportError:
        print("curl_cffi        MISSING — browser impersonation unavailable")
        problems.append("curl_cffi is not installed")

    if problems:
        print("\nproblems:")
        for problem in problems:
            print(f"  - {problem}")
        return 1
    print("\nno problems found")
    return 0


def cmd_once(wallet_id: str) -> int:
    config = config_mod.load()
    vault = Vault()
    unlock(vault)
    wallet = vault.get(wallet_id)
    if wallet is None:
        sys.exit(f"error: no wallet {wallet_id!r}")

    transport = Transport.for_wallet(config, wallet)
    sessions = SessionManager(config)
    session = sessions.get(wallet, transport)
    api = GameApi(transport)
    state = api.get_player(session)

    orchestrator = Orchestrator(config=config, api=api)
    decision = orchestrator.decide_and_act(wallet, session, state, None)
    print("\n".join(decision.rationale_lines()))
    if decision.error:
        print(f"\nerror: {decision.error}")
    if decision.result:
        print(f"\nresult: {json.dumps(decision.result, indent=2, default=str)[:1500]}")
    transport.close()
    return 1 if decision.error else 0


def _clan_session(vault, config, wallet_id: str):
    """Open one authenticated session, or exit with a clear message."""
    wallet = vault.get(wallet_id)
    if wallet is None:
        sys.exit(f"error: no wallet {wallet_id!r}")
    transport = Transport.for_wallet(config, wallet)
    session = SessionManager(config).get(wallet, transport)
    return wallet, transport, session


def cmd_clan_status() -> int:
    from slcw import clan as clan_mod
    config = config_mod.load()
    vault = Vault()
    unlock(vault)
    print(f"{'wallet':12} {'lvl':>4} {'gold':>8} {'clan':22} {'role':9} {'dkp':>6}  note")
    levels, info = {}, None
    for entry in vault.wallets():
        wallet_id = entry["id"]
        transport = Transport.for_wallet(config, entry)
        try:
            session = SessionManager(config).get(entry, transport)
            api = GameApi(transport)
            state = api.get_player(session)
            clan_id = str((state.raw or {}).get("clanId") or "")
            if not clan_id:
                short = "-"
                role, dkp, note = "-", 0, ""
                if state.gold >= clan_mod.CREATE_CLAN_GOLD:
                    note = "can found a clan"
                else:
                    note = (f"{clan_mod.CREATE_CLAN_GOLD - state.gold:,} short "
                            f"of founding")
            else:
                doc = api.get_clan(session, clan_id)
                short = f"{doc.get('name', '?')[:14]} [{doc.get('tag', '?')}]"
                member = clan_mod.parse_membership(
                    clan_id, api.get_clan_member(session, clan_id, session.local_id))
                role, dkp = member.role, member.dkp
                flags = []
                if member.on_probation():
                    flags.append("probation")
                if member.donated_today():
                    flags.append("donated today")
                note = ", ".join(flags)
                if info is None:
                    info = clan_mod.parse_clan(clan_id, doc)
            levels[wallet_id] = state.level
            print(f"{wallet_id:12} {state.level:>4} {state.gold:>8,} {short:22} "
                  f"{role:9} {dkp:>6}  {note}")
        except Exception as exc:  # one bad wallet must not hide the rest
            print(f"{wallet_id:12} {'?':>8} {'error':22} {'-':9} {'-':>6}  {exc}")
        finally:
            transport.close()

    # Seats are 5 x level + 5, measured against every clan in the game. With
    # more wallets than seats the fleet cannot all be inside, so print who the
    # decision loop will actually put there and what it costs to widen it.
    fleet = len(levels)
    if info is not None:
        print(f"\n{info.name or info.clan_id}: level {info.level}, "
              f"{info.member_count}/{info.max_members} seats, "
              f"{info.xp:,}/{info.xp_required:,} clan XP")
        if info.max_members < fleet:
            need = clan_mod.levels_for_seats(fleet)
            missing = max(0, clan_mod.xp_to_reach(info.level, need) - info.xp)
            print(f"  level {need} ({clan_mod.max_members(need)} seats) holds all "
                  f"{fleet} wallets: {missing:,} clan XP away, "
                  f"~{-(-missing // clan_mod.QUEST_CLAN_XP)} clan quest(s)")
        roster = clan_mod.seat_ranking(levels, info.max_members)
        print("  seats go to: " + ", ".join(roster))
    return 0


def cmd_clan_create(wallet_id: str, name: str, tag: str) -> int:
    from slcw import clan as clan_mod
    config = config_mod.load()
    vault = Vault()
    unlock(vault)
    wallet, transport, session = _clan_session(vault, config, wallet_id)
    try:
        api = GameApi(transport)
        state = api.get_player(session)
        if state.gold < clan_mod.CREATE_CLAN_GOLD:
            sys.exit(f"error: {wallet_id} has {state.gold:,} gold, needs "
                     f"{clan_mod.CREATE_CLAN_GOLD:,}")
        print(f"Founding {name!r} [{tag}] from {wallet_id} "
              f"({state.gold:,} gold) — this spends "
              f"{clan_mod.CREATE_CLAN_GOLD:,} gold.")
        if input("  type the clan name to confirm: ").strip() != name:
            sys.exit("aborted")
        result = api.create_clan(session, name, tag)
        print(json.dumps(result, indent=2, default=str)[:800])
        after = api.get_player(session)
        print(f"\nclanId: {(after.raw or {}).get('clanId', '(check clan-status)')}")
        print(f"gold: {state.gold:,} -> {after.gold:,}")
        return 0
    finally:
        transport.close()


def cmd_clan_apply(clan_id: str, wallet_ids: list) -> int:
    config = config_mod.load()
    vault = Vault()
    unlock(vault)
    targets = wallet_ids or [w["id"] for w in vault.wallets()]
    sent = 0
    for wallet_id in targets:
        entry = vault.get(wallet_id)
        if entry is None:
            print(f"  {wallet_id:12} no such wallet")
            continue
        transport = Transport.for_wallet(config, entry)
        try:
            session = SessionManager(config).get(entry, transport)
            api = GameApi(transport)
            state = api.get_player(session)
            if (state.raw or {}).get("clanId"):
                print(f"  {wallet_id:12} already in a clan")
                continue
            result = api.apply_clan(session, clan_id)
            app = (result.get("result") or result).get("applicationId", "?")
            print(f"  {wallet_id:12} applied ({app})")
            sent += 1
        except Exception as exc:
            print(f"  {wallet_id:12} {type(exc).__name__}: {str(exc)[:70]}")
        finally:
            transport.close()
    print(f"{sent} application(s) sent")
    return 0


def cmd_clan_accept(clan_id: str) -> int:
    """Accept every pending application, from whichever wallet leads the clan."""
    config = config_mod.load()
    vault = Vault()
    unlock(vault)
    for entry in vault.wallets():
        transport = Transport.for_wallet(config, entry)
        try:
            session = SessionManager(config).get(entry, transport)
            api = GameApi(transport)
            state = api.get_player(session)
            if str((state.raw or {}).get("clanId") or "") != clan_id:
                continue
            member = api.get_clan_member(session, clan_id, session.local_id)
            if str((member or {}).get("role") or "") not in ("leader", "officer"):
                continue
            pending = api.get_clan_applications(session, clan_id)
            if not pending:
                print("no pending applications")
                return 0
            for app in pending:
                app_id = app.get("applicationId", "")
                try:
                    api.resolve_clan_application(session, app_id, "accept")
                    print(f"  accepted {app_id}")
                except Exception as exc:
                    print(f"  {app_id} {type(exc).__name__}: {str(exc)[:70]}")
            return 0
        finally:
            transport.close()
    sys.exit(f"error: no wallet leads clan {clan_id!r}")


def cmd_clan_quest(wallet_id: str, clan_id: str) -> int:
    config = config_mod.load()
    vault = Vault()
    unlock(vault)
    wallet, transport, session = _clan_session(vault, config, wallet_id)
    try:
        result = GameApi(transport).generate_clan_quest(session, clan_id)
        print(json.dumps(result, indent=2, default=str)[:800])
        return 0
    finally:
        transport.close()


def cmd_why(wallet_id: str) -> int:
    from slcw.runner import FLEET_STATE
    if not FLEET_STATE.exists():
        sys.exit("no fleet state yet")
    payload = json.loads(FLEET_STATE.read_text())
    status = (payload.get("wallets") or {}).get(wallet_id)
    if not status:
        sys.exit(f"no status for {wallet_id!r}")
    for line in status.get("rationale") or ["(no decision recorded)"]:
        print(line)
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    command, *rest = argv
    if command == "setup":
        from slcw.setup_wizard import run
        return run()
    if command == "init":
        return cmd_init()
    if command == "list":
        return cmd_list()
    if command == "new":
        return cmd_new(int(rest[0]) if rest else 1)
    if command == "import":
        return cmd_import()
    if command == "doctor":
        return cmd_doctor()
    if command == "once":
        if not rest:
            sys.exit("usage: slcwctl once <wallet-id>")
        return cmd_once(rest[0])
    if command == "clan-status":
        return cmd_clan_status()
    if command == "clan-create":
        if len(rest) < 3:
            sys.exit('usage: slcwctl clan-create <wallet-id> "<name>" "<TAG>"')
        return cmd_clan_create(rest[0], rest[1], rest[2])
    if command == "clan-apply":
        if not rest:
            sys.exit("usage: slcwctl clan-apply <clanId> [wallet-id ...]")
        return cmd_clan_apply(rest[0], rest[1:])
    if command == "clan-accept":
        if not rest:
            sys.exit("usage: slcwctl clan-accept <clanId>")
        return cmd_clan_accept(rest[0])
    if command == "clan-quest":
        if len(rest) < 2:
            sys.exit("usage: slcwctl clan-quest <wallet-id> <clanId>")
        return cmd_clan_quest(rest[0], rest[1])
    if command == "why":
        if not rest:
            sys.exit("usage: slcwctl why <wallet-id>")
        return cmd_why(rest[0])
    sys.exit(f"unknown command {command!r} — see slcwctl --help")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
